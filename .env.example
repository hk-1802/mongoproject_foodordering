PORT=5000
# Local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/food_ordering
JWT_SECRET=replace_with_a_long_random_string

# Admin account (created automatically on first start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# Additional admins — comma-separated "email:password"
# EXTRA_ADMINS=someone@example.com:theirpassword
